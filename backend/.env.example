# ============================================================
# Sulnet V1 — Variáveis de Ambiente
# Configure estas variáveis no Railway: serviço → Variables
# ============================================================

# ── OBRIGATÓRIO — Banco de Dados ───────────────────────────
# Railway gera automaticamente ao adicionar o plugin PostgreSQL
# Vá em: seu projeto Railway → + New → Database → Add PostgreSQL
# A variável DATABASE_URL aparece automaticamente no seu serviço
DATABASE_URL=postgresql://user:password@host:5432/crm_sulnet

# ── OBRIGATÓRIO — Segurança JWT ────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_aqui_uma_chave_aleatoria_longa
JWT_EXPIRES=12h

# ── OBRIGATÓRIO — Ambiente ─────────────────────────────────
NODE_ENV=production
PORT=3000

# ── OPCIONAL — Cloudflare R2 (uploads de documentos) ───────
# Sem isso o sistema funciona, mas uploads de arquivos ficam desativados
# Crie em: cloudflare.com → R2 → Create bucket → Manage R2 API Tokens
R2_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=sistema-integrado-sulnet-v1-docs

# ── OPCIONAL — CORS ────────────────────────────────────────
# Se não configurar, aceita qualquer origem (ok para primeiro deploy)
# Depois configure com seu domínio real:
ALLOWED_ORIGINS=https://crmv1-production-56bc.up.railway.app

# ── OPCIONAL — Google Calendar ─────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=786355285772-0hujrij5hpadrddjq9konaci7825ljr8.apps.googleusercontent.com


# Atendimento WhatsApp / Filas
CHAT_DEFAULT_DISTRIBUTION=manual
